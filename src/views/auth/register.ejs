<div class="min-h-[80vh] flex items-center justify-center py-8">
	<div class="w-full max-w-md">
		<!-- Logo/Brand -->
		<div class="text-center mb-8">
			<h1 class="text-3xl font-bold text-slate-800">Create Account</h1>
			<p class="text-gray-600 mt-2">Start your fitness journey today</p>
		</div>

		<!-- Register Card -->
		<div class="bg-white p-8 rounded-lg shadow border border-slate-200">
			<!-- Quick Sign Up with Social -->
			<% if (typeof socialProviders !== 'undefined' && (socialProviders.google || socialProviders.facebook || socialProviders.twitter)) { %>
				<div class="mb-6">
					<p class="text-center text-sm text-gray-600 mb-4">Quick sign up with</p>
					<div class="space-y-3">
						<% if (socialProviders.google) { %>
							<a 
								href="/auth/google" 
								class="flex items-center justify-center gap-3 w-full px-4 py-3 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors"
							>
								<svg class="w-5 h-5" viewBox="0 0 24 24">
									<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
									<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
									<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
									<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
								</svg>
								<span class="text-gray-700 font-medium">Continue with Google</span>
							</a>
						<% } %>

						<% if (socialProviders.facebook) { %>
							<a 
								href="/auth/facebook" 
								class="flex items-center justify-center gap-3 w-full px-4 py-3 bg-[#1877F2] text-white rounded-lg hover:bg-[#166FE5] transition-colors"
							>
								<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
									<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
								</svg>
								<span class="font-medium">Continue with Facebook</span>
							</a>
						<% } %>

						<% if (socialProviders.twitter) { %>
							<a 
								href="/auth/twitter" 
								class="flex items-center justify-center gap-3 w-full px-4 py-3 bg-black text-white rounded-lg hover:bg-gray-900 transition-colors"
							>
								<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
									<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
								</svg>
								<span class="font-medium">Continue with X</span>
							</a>
						<% } %>
					</div>

					<div class="relative my-6">
						<div class="absolute inset-0 flex items-center">
							<div class="w-full border-t border-gray-200"></div>
						</div>
						<div class="relative flex justify-center text-sm">
							<span class="px-4 bg-white text-gray-500">Or register with email</span>
						</div>
					</div>
				</div>
			<% } %>

			<!-- Error Messages -->
			<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
				<div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-6">
					<div class="flex items-start gap-2">
						<svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<div>
							<p class="font-medium">Please fix the following errors:</p>
							<ul class="mt-1 list-disc list-inside text-sm">
								<% errors.forEach(error => { %>
									<li><%= error.msg %></li>
								<% }) %>
							</ul>
						</div>
					</div>
				</div>
			<% } %>

			<form method="POST" action="/register" class="space-y-5">
				<!-- Display Name Field -->
				<div>
					<label for="displayName" class="block text-sm font-medium text-gray-700 mb-2">
						Display Name
					</label>
					<input 
						type="text" 
						id="displayName" 
						name="displayName" 
						autocomplete="name"
						class="w-full px-4 py-3 bg-white text-gray-900 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-shadow"
						placeholder-gray-500" placeholder="John Doe"
						value="<%= typeof formData !== 'undefined' ? formData.displayName || '' : '' %>"
					>
				</div>


				<!-- Date of Birth Field -->
				<div>
					<label for="dateOfBirth" class="block text-sm font-medium text-gray-700 mb-2">
						Date of Birth <span class="text-red-500">*</span>
					</label>
					<input
						type="date"
						id="dateOfBirth"
						name="dateOfBirth"
						required
						autocomplete="bday"
						class="w-full px-4 py-3 bg-white text-gray-900 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-shadow"
						value="<%= typeof formData !== 'undefined' ? formData.dateOfBirth || '' : '' %>"
					>
					<p class="mt-1 text-xs text-gray-500">Used to calculate age for personalized metrics</p>
				</div>
				<!-- Username Field -->
				<div>
					<label for="username" class="block text-sm font-medium text-gray-700 mb-2">
						Username <span class="text-red-500">*</span>
					</label>
					<input 
						type="text" 
						id="username" 
						name="username" 
						required
						autocomplete="username"
						class="w-full px-4 py-3 bg-white text-gray-900 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-shadow"
						placeholder-gray-500" placeholder="johndoe"
						value="<%= typeof formData !== 'undefined' ? formData.username || '' : '' %>"
					>
					<p class="mt-1 text-xs text-gray-500">3-30 characters, letters, numbers, and underscores only</p>
				</div>

				<!-- Email Field -->
				<div>
					<label for="email" class="block text-sm font-medium text-gray-700 mb-2">
						Email Address <span class="text-red-500">*</span>
					</label>
					<input 
						type="email" 
						id="email" 
						name="email" 
						required
						autocomplete="email"
						class="w-full px-4 py-3 bg-white text-gray-900 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-shadow"
						placeholder-gray-500" placeholder="you@example.com"
						value="<%= typeof formData !== 'undefined' ? formData.email || '' : '' %>"
					>
				</div>

				<!-- Password Field -->
				<div>
					<label for="password" class="block text-sm font-medium text-gray-700 mb-2">
						Password <span class="text-red-500">*</span>
					</label>
					<input 
						type="password" 
						id="password" 
						name="password" 
						required
						autocomplete="new-password"
						class="w-full px-4 py-3 bg-white text-gray-900 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-shadow"
						placeholder-gray-500" placeholder="Create a strong password"
					>
					<p class="mt-1 text-xs text-gray-500">Min 8 characters with uppercase, lowercase, and number</p>
				</div>

				<!-- Unit System Dropdown -->
				<div>
					<label for="unitSystem" class="block text-sm font-medium text-gray-700 mb-2">
						Unit System <span class="text-red-500">*</span>
					</label>
					<select 
						id="unitSystem" 
						name="unitSystem" 
						required
						class="w-full px-4 py-3 bg-white text-gray-900 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-shadow"
					>
						<option value="IMPERIAL" <%= typeof formData !== 'undefined' && formData.unitSystem === 'IMPERIAL' ? 'selected' : '' %>>Imperial (lbs, ft/in)</option>
						<option value="METRIC" <%= typeof formData !== 'undefined' && formData.unitSystem === 'METRIC' ? 'selected' : '' %>>Metric (kg, cm)</option>
					</select>
				</div>

				<!-- Height Field -->
				<div>
					<label for="height" class="block text-sm font-medium text-gray-700 mb-2">
						Height <span class="text-red-500">*</span>
					</label>
					<input 
						type="number" 
						id="height" 
						name="height" 
						required
						step="0.1"
						min="1"
						max="300"
						class="w-full px-4 py-3 bg-white text-gray-900 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-shadow"
						placeholder-gray-500" placeholder="Height"
						value="<%= typeof formData !== 'undefined' ? formData.height || '' : '' %>"
					>
					<p class="mt-1 text-xs text-gray-500">In inches (Imperial) or centimeters (Metric)</p>
				</div>

				<!-- Current Weight Field -->
				<div>
					<label for="currentWeight" class="block text-sm font-medium text-gray-700 mb-2">
						Current Weight <span class="text-red-500">*</span>
					</label>
					<input 
						type="number" 
						id="currentWeight" 
						name="currentWeight" 
						required
						step="0.1"
						min="0.1"
						max="1000"
						class="w-full px-4 py-3 bg-white text-gray-900 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-shadow"
						placeholder-gray-500" placeholder="Current weight"
						value="<%= typeof formData !== 'undefined' ? formData.currentWeight || '' : '' %>"
					>
					<p class="mt-1 text-xs text-gray-500">In pounds (Imperial) or kilograms (Metric)</p>
				</div>

				<!-- Goal Weight Field (Optional) -->
				<div>
					<label for="goalWeight" class="block text-sm font-medium text-gray-700 mb-2">
						Goal Weight <span class="text-gray-400 text-xs">(optional)</span>
					</label>
					<input 
						type="number" 
						id="goalWeight" 
						name="goalWeight" 
						step="0.1"
						min="0.1"
						max="1000"
						class="w-full px-4 py-3 bg-white text-gray-900 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-shadow"
						placeholder-gray-500" placeholder="Goal weight (can fill in later)"
						value="<%= typeof formData !== 'undefined' ? formData.goalWeight || '' : '' %>"
					>
					<p class="mt-1 text-xs text-gray-500">In pounds (Imperial) or kilograms (Metric)</p>
				</div>

				<!-- Activity Level Dropdown -->
				<div>
					<label for="activityLevel" class="block text-sm font-medium text-gray-700 mb-2">
						Activity Level <span class="text-red-500">*</span>
					</label>
					<select 
						id="activityLevel" 
						name="activityLevel" 
						required
						class="w-full px-4 py-3 bg-white text-gray-900 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-shadow"
					>
						<option value="" disabled <%= typeof formData === 'undefined' || !formData.activityLevel ? 'selected' : '' %>>Select your activity level</option>
						<option value="SEDENTARY" <%= typeof formData !== 'undefined' && formData.activityLevel === 'SEDENTARY' ? 'selected' : '' %>>Sedentary (little or no exercise)</option>
						<option value="LIGHTLY_ACTIVE" <%= typeof formData !== 'undefined' && formData.activityLevel === 'LIGHTLY_ACTIVE' ? 'selected' : '' %>>Lightly Active (light exercise 1-3 days/week)</option>
						<option value="MODERATELY_ACTIVE" <%= typeof formData !== 'undefined' && formData.activityLevel === 'MODERATELY_ACTIVE' ? 'selected' : '' %>>Moderately Active (moderate exercise 3-5 days/week)</option>
						<option value="VERY_ACTIVE" <%= typeof formData !== 'undefined' && formData.activityLevel === 'VERY_ACTIVE' ? 'selected' : '' %>>Very Active (hard exercise 6-7 days/week)</option>
						<option value="EXTREMELY_ACTIVE" <%= typeof formData !== 'undefined' && formData.activityLevel === 'EXTREMELY_ACTIVE' ? 'selected' : '' %>>Extremely Active (very hard exercise, physical job)</option>
					</select>
				</div>

				<!-- Terms Checkbox -->
				<div class="flex items-start">
					<input 
						type="checkbox" 
						id="terms" 
						name="terms" 
						required
						class="w-4 h-4 mt-0.5 text-teal-500 border-gray-300 rounded focus:ring-teal-500"
					>
					<label for="terms" class="ml-2 text-sm text-gray-600">
						I agree to the 
						<a href="/terms" class="text-teal-600 hover:underline">Terms of Service</a> 
						and 
						<a href="/privacy" class="text-teal-600 hover:underline">Privacy Policy</a>
					</label>
				</div>

				<!-- Submit Button -->
				<button 
					type="submit" 
					class="w-full px-4 py-3 bg-teal-500 text-white font-medium rounded-lg hover:bg-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 transition-colors"
				>
					Create Account
				</button>
			</form>

			<!-- Divider -->
			<div class="relative my-6">
				<div class="absolute inset-0 flex items-center">
					<div class="w-full border-t border-gray-200"></div>
				</div>
				<div class="relative flex justify-center text-sm">
					<span class="px-4 bg-white text-gray-500">Already have an account?</span>
				</div>
			</div>

			<!-- Login Link -->
			<a 
				href="/login" 
				class="block w-full px-4 py-3 text-center border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors"
			>
				Sign In
			</a>
		</div>
	</div>
</div>
